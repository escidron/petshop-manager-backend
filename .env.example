# PostgreSQL — Railway provê automaticamente via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
APP_NAME="Pet Controle"


# Gere com: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# Token config
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CEP_BASE_URL=https://viacep.com.br/ws

# CORS — URL do frontend no Vercel (sem barra no final)
ALLOWED_ORIGINS=https://seu-app.vercel.app

ENVIRONMENT=production

# Pagar.me — Dashboard > Configurações > Dados da API
PAGARME_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAGARME_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Pagar.me — configurar após criar o webhook no dashboard
PAGARME_WEBHOOK_SECRET=

# Resend Email Settings
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL="seu-email-para-receber-logs@dominio.com"

GCP_PROJECT_ID="COLE_AQUI_O_VALOR_DE_project_id"
GCP_CLIENT_EMAIL="COLE_AQUI_O_VALOR_DE_client_email"
GCP_PRIVATE_KEY="COLE_AQUI_O_VALOR_DE_private_key"
GCS_BUCKET_NAME="nome do bucket"