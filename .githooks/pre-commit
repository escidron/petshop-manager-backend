#!/bin/sh
# Git pre-commit hook: Executa os testes unitários antes de permitir o commit

echo "========================================================"
echo "🧪 [PRE-COMMIT] Executando testes unitários do Back-end..."
echo "========================================================"

# Identifica o executável do pytest (suporte a Windows .venv e Linux/macOS)
if [ -f "./.venv/Scripts/pytest.exe" ]; then
    PYTEST_CMD="./.venv/Scripts/pytest.exe"
elif [ -f "./.venv/bin/pytest" ]; then
    PYTEST_CMD="./.venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
    PYTEST_CMD="pytest"
else
    echo "⚠️  [AVISO] Ambiente virtual ou pytest não encontrado em .venv."
    echo "Pulando execução automática dos testes."
    exit 0
fi

$PYTEST_CMD -p no:warnings -q
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [PRE-COMMIT BLOQUEADO] Um ou mais testes falharam!"
    echo "Corrija os erros antes de commitar ou use 'git commit --no-verify' em caso de emergência."
    echo "========================================================"
    exit 1
fi

echo "✅ [PRE-COMMIT APROVADO] Todos os testes passaram com sucesso!"
echo "========================================================"
exit 0
